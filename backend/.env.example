APP_ENV=development
APP_NAME=DriveDeal API
API_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./data/drivedeal.db
# RDS example (username is required before use):
# DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@YOUR-RDS-HOST:5432/YOUR-DATABASE
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AWS_REGION=your-aws-region
S3_BUCKET=your-private-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_DRIVER=s3
# Serra credential precedence: OPENAI_API_KEY, then CODEX_OAUTH_ACCESS_TOKEN (a fixed, short-lived
# token), then CODEX_OAUTH_CLIENT_ID + CODEX_OAUTH_REFRESH_TOKEN (self-refreshing — recommended for
# a single-developer "Sign in with ChatGPT" setup), then a cached S3 login
# (`uv run python -m src.codex_login`). OAuth state is encrypted at rest under the private S3 prefix below.
# CODEX_OAUTH_REFRESH_TOKEN is a long-lived secret, equivalent
# to a password for that ChatGPT account — treat it like JWT_SECRET_KEY/AWS keys below.
OPENAI_API_KEY=
CODEX_OAUTH_ACCESS_TOKEN=
CODEX_OAUTH_CLIENT_ID=
CODEX_OAUTH_REFRESH_TOKEN=
CODEX_OAUTH_S3_PREFIX=private/codex-oauth
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
AI_PROVIDER=openai
AI_DISABLED=false
AI_ENABLE_WEB_SEARCH=false
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=1800
AI_REQUEST_TIMEOUT_SECONDS=45
# LangSmith tracing (optional) for inspecting LangGraph/LLM runs in the LangSmith UI:
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=drivedeal-serra
LANGSMITH_ENDPOINT=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_REQUEST_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
LOG_FLOW_ENABLED=true
