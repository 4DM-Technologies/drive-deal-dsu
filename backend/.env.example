APP_ENV=development
APP_NAME=DriveDeal API
API_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./data/drivedeal.db
# RDS example (username is required before use):
# DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@drive-deal-dsu.c1kw2ik60giz.ap-south-1.rds.amazonaws.com:5432/drive-deal-dsu
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AWS_REGION=ap-south-1
S3_BUCKET=drive-deal-dsu
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_DRIVER=local
AUTO_SEED_DEMO=false
OPENAI_API_KEY=
CODEX_OAUTH_ACCESS_TOKEN=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=medium
AI_PROVIDER=openai
AI_DISABLED=false
AI_ENABLE_WEB_SEARCH=false
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=1800
AI_REQUEST_TIMEOUT_SECONDS=45
