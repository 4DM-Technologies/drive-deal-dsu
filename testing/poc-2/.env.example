# This POC reuses the backend's "Sign in with ChatGPT" OAuth credential by default
# (see llm_client.py) - these are only needed if you want to override that with a
# plain API key instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Search providers ---
ENABLE_DUCKDUCKGO=true
ENABLE_SEARXNG=true

# SearXNG needs a running instance. Fastest way to get one locally:
#   docker run -d --name searxng -p 8080:8080 searxng/searxng
# Then confirm it works: http://localhost:8080/search?q=test&format=json
# (SearXNG's default settings.yml disables the json output format - see README.md
# "SearXNG setup" for the one-line config change needed.)
SEARXNG_URL=http://localhost:8080

MAX_RESULTS_PER_PROVIDER=10
MAX_CRAWL_CANDIDATES=8
