# LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Primary search: Google Custom Search JSON API.
# 1. Create an API key: https://console.cloud.google.com/apis/credentials
# 2. Create a Programmable Search Engine (set to search the whole web): https://programmablesearchengine.google.com/
# 3. Free tier: 100 queries/day.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# No key needed for the DuckDuckGo fallback - it's used automatically if Google
# isn't configured or its call fails.
